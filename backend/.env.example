# City Explorer Backend 环境变量配置
# 复制此文件为 .env 并填写实际值。不要提交 .env。

# 服务器配置
PORT=5000
NODE_ENV=development

# 数据库配置（MongoDB Atlas 或本地）
MONGODB_URI=mongodb://localhost:27017/city_explorer
# 生产环境可填写 MongoDB Atlas 提供的完整连接字符串。

# JWT 配置（生产环境必须使用强随机字符串）
# 生成方法: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production

# 前端 URL (用于 CORS 配置)
# 开发环境
FRONTEND_URL=http://localhost:5173
# 生产环境（多个域名用逗号分隔）
# FRONTEND_URL=https://yourdomain.com,capacitor://localhost

# 文件存储配置
# 本地存储 (默认)
STORAGE_TYPE=local

# 奇遇调试开关（生产环境必须为 false）
SERENDIPITY_DEBUG_MODE=false

# 当前仓库只实现了本地文件存储。接入对象存储后再添加对应凭据；
# 不要把任何 Access Key 写入版本库。
# STORAGE_TYPE=oss
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_BUCKET=your-bucket-name
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
